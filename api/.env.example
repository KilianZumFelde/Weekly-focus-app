# Database — Supabase connection string (Session mode, port 5432)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Test database — separate Supabase project used for integration tests only
TEST_DATABASE_URL=postgresql://postgres:[password]@db.[test-project-ref].supabase.co:5432/postgres

# Supabase — used to verify JWTs issued by Supabase Auth
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic — Claude API key (never share or commit)
ANTHROPIC_API_KEY=sk-ant-...

# AI model selection (overridable without a code change)
CLAUDE_PARSE_MODEL=claude-haiku-4-5-20251001
CLAUDE_COACH_MODEL=claude-sonnet-4-6

# Server
PORT=3000
NODE_ENV=development
